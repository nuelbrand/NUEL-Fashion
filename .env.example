# ============================================================
# NUEL FASHION — ENVIRONMENT VARIABLES
# ============================================================
# HOW TO USE THIS FILE:
#   1. Copy this file and rename it to ".env"
#   2. Fill in your real values where shown below
#   3. NEVER commit your ".env" file to GitHub (it's in .gitignore)
#   4. In Cloudflare Pages, add these same variables in:
#      Settings → Environment Variables
#
# All variables must start with VITE_ to be accessible
# in your React code (Vite security requirement).
# ============================================================

# ─── SUPABASE ────────────────────────────────────────────────
# Get these from: supabase.com → Your Project → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ─── PAYSTACK ────────────────────────────────────────────────
# Get this from: dashboard.paystack.com → Settings → API Keys
# Use the TEST key during development, LIVE key for production
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your-paystack-public-key-here

# ─── CURRENCY ────────────────────────────────────────────────
# Exchange rate: 1 USD = this many NGN
# In production, replace this with a live exchange rate API call
VITE_USD_TO_NGN=1600

# ─── APP SETTINGS ────────────────────────────────────────────
VITE_APP_NAME=NUEL Fashion
VITE_DEFAULT_CURRENCY=NGN
VITE_IMAGE_BUCKET=product-images
